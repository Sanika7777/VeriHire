# Copy to .env and fill in real values for local development.
# Never commit a populated .env file.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- API ---
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Postgres 16 + pg_trgm + pgvector) ---
DATABASE_URL=postgresql+asyncpg://verihire:verihire@localhost:5432/verihire

# --- Cache / rate limiting ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth (Authorization Code + PKCE) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Object storage (MinIO locally, R2 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=verihire
S3_SECRET_KEY=verihire123
S3_BUCKET=verihire-evidence

# --- Email (MailHog locally, Resend in prod) ---
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Observability ---
SENTRY_DSN=

# --- External signal integrations (services/ml + verification module) ---
SAFE_BROWSING_API_KEY=
OPENCORPORATES_API_KEY=

# --- ML ---
ML_ARTIFACTS_DIR=../../services/ml/artifacts

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
